# Copier ce fichier en ".env" et remplir les valeurs.
# Le fichier .env est ignoré par Git : tes clés ne seront jamais publiées.

# Clé API Gemini principale (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Clé de secours, optionnelle (utilisée si la principale atteint son quota)
GEMINI_API_KEY_FALLBACK=

# Chemin vers le fichier de credentials du compte de service Google Cloud (OCR Vision)
GOOGLE_APPLICATION_CREDENTIALS=
